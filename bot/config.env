# ─────────────────────────────────────────────────────────────────────────────
# Space Crime Continuum — NON-SECRET config only.
#
# YouTube OAuth secrets (CLIENT_ID / CLIENT_SECRET / REFRESH_TOKEN) are injected
# from GitHub Secrets at runtime. Artwork is read from the local checkout in
# Actions (this repo IS the artwork repo), so no GitHub token is needed there.
# NEVER put tokens in this file — it is committed to the repo.
# ─────────────────────────────────────────────────────────────────────────────

# Artwork location. In Actions the workflow sets LOCAL_ARTWORK_ROOT and the bot
# reads GITHUB_THUMBNAILS_PATH/<slug>.<ext> off disk. GITHUB_REPO/BRANCH are only
# used for the HTTPS fallback when running locally on the laptop.
GITHUB_REPO=wesmith1017-lab/yt-thumbnails
GITHUB_BRANCH=main
GITHUB_THUMBNAILS_PATH=space-crime-continuum

# YouTube playlist to watch
YOUTUBE_PLAYLIST_ID=PLd0x0jcI5YqOfa5oAEvlMOvRj0cgRfjSG
